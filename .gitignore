# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/out.prev/
# earlier builds' /_next/static, carried into each export (scripts/keep-previous-assets.mjs)
/.static-archive/
# full-size gallery masters, never shipped: public repo, unpublished likeness (scripts/optimize-gallery.mjs)
/assets/gallery/*
!/assets/gallery/README.md

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
