# Static site served from cPanel (behind Cloudflare). Next.js export output.
# Note: HTTPS redirect is handled by Cloudflare ("Always Use HTTPS"); do NOT add one
# here or it can loop behind the proxy.

ErrorDocument 404 /404.html

# /reviews/ removed 2026-08-17 — it carried six fabricated testimonials (see
# docs/business-facts.md §B). Returns as a real page once verifiable reviews exist.
Redirect 301 /reviews/ /about/

# Long-cache fingerprinted Next.js assets; Cloudflare also caches at the edge.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Security baseline (backlog §12.1). Cloudflare already adds nosniff + referrer-policy;
  # duplicates are harmless and this keeps the origin correct even if the proxy changes.
  # HSTS is deliberately WITHOUT `includeSubDomains` (cPanel service subdomains like
  # webmail/mail are not guaranteed HTTPS) and WITHOUT `preload` (near-irreversible —
  # owner's call, see docs/business-facts.md §F). Escalate only with the owner's sign-off.
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
</IfModule>
