# Static site served from cPanel (behind Cloudflare). Next.js export output.
# Note: HTTPS redirect is handled by Cloudflare ("Always Use HTTPS"); do NOT add one
# here or it can loop behind the proxy.

ErrorDocument 404 /404.html

# Long-cache fingerprinted Next.js assets; Cloudflare also caches at the edge.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
